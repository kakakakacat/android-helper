<?xml version="1.0" encoding="utf-8"?>
<!--
  AAR 的清单会被合并进使用方的 APK，所以 provider 是"加了依赖就自动生效"的关键：
  使用方不需要改 Application、不需要注册任何东西。

  也正因为如此，这个 AAR 绝不能进 release —— 由 Gradle 插件按 build type 决定是否加依赖。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <provider
            android:name="kakacat.android.helper.HelperInitProvider"
            android:authorities="${applicationId}.androidhelper.init"
            android:exported="false"
            android:multiprocess="true" />
    </application>

</manifest>
